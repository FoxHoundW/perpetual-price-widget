{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "永续价格悬浮窗",
  "version": "1.1.0",
  "identifier": "io.github.foxhoundw.perpetual-price-widget",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "永续价格悬浮窗",
        "url": "index.html?view=widget",
        "width": 392,
        "height": 154,
        "minWidth": 300,
        "minHeight": 66,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": true,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "币安永续合约价格与异动提醒悬浮窗",
    "longDescription": "只读展示币安 USDⓈ-M 和 COIN-M 永续合约最新成交价与异动提醒。",
    "copyright": "Copyright © 2026 FoxHoundW",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
